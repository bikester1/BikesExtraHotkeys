{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Release)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "ExtraHotkeys.sln", "-c", "Release"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Build (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "ExtraHotkeys.sln", "-c", "Debug"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Publish to Paradox Mods",
      "detail": "Uploads to Paradox Mods (ModId 113726). Choose a profile when prompted.",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "ExtraHotkeys.sln",
        "-c",
        "Release",
        "-p:PublishProfile=${input:publishProfile}"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "publishProfile",
      "type": "pickString",
      "description": "Publish profile (this uploads to Paradox Mods)",
      "options": [
        "UpdatePublishedConfiguration",
        "PublishNewVersion",
        "PublishNewMod"
      ],
      "default": "UpdatePublishedConfiguration"
    }
  ]
}
